# 64-bit Armadillo indices (arma::uword) on 64-bit platforms: the kernels
# view R's matrices without copying them, and a 32-bit word wraps past
# 2^32 - 1 elements.
PKG_CPPFLAGS = -DARMA_64BIT_WORD=1
PKG_CXXFLAGS = $(SHLIB_OPENMP_CXXFLAGS)
PKG_LIBS = $(SHLIB_OPENMP_CXXFLAGS) $(LAPACK_LIBS) $(BLAS_LIBS) $(FLIBS)
